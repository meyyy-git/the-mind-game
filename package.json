{
  "name": "the-minds-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "bun --bun vite --host 0.0.0.0",
    "build": "bun run check && bun --bun vite build",
    "start": "bun server/index.ts",
    "test": "bun test",
    "check": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.34",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
